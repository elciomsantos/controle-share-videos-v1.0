# .env.local — Variáveis para docker-compose.local.yml (gitignored).
# Copie este arquivo: cp .env.local.example .env.local

# === OBRIGATÓRIOS ===

# Senha do admin bootstrap. Gerar com: openssl rand -base64 32
ADMIN_PASSWORD=

# Segredo de assinatura JWT (compartilhado entre backend e frontend middleware).
# Gerar com: openssl rand -base64 32
# IMPORTANTE: se mudar este valor após já ter sessões ativas, todos os tokens
# existentes são invalidados (esperado após rotação de segredo).
JWT_SECRET=

# === OPCIONAIS (com defaults) ===

# Credenciais do admin bootstrap
# ADMIN_EMAIL=admin@empresa.local
# ADMIN_USERNAME=admin

# === HOMOLOGAÇÃO EM REDE INTERNA (OPCIONAL) ===
# Usadas pelo overlay docker-compose.lan.yml (+ Caddyfile.lan, TLS autoassinado).
# LAN_HOST: IP que será o certificado principal e o general.appUrl pós-boot
# (durante homologação em WSL use o IP da máquina atual; no deploy troque pelo
# IP fixo do servidor final). Acesso dos testadores: https://<LAN_HOST>
# TLS_EXTRA_HOSTS (opcional): IP adicional incluído como SAN no certificado
# (ex.: o IP do servidor final enquanto homologa em outra máquina).
# Em WSL2 modo NAT, rode antes scripts/provision/wsl-lan-expose.ps1 -Scope <subrede>
# (PowerShell como Administrador no Windows).
# LAN_HOST=192.168.0.246
# TLS_EXTRA_HOSTS=10.10.10.202

# === HTTPS / Let's Encrypt (modo prod, OPCIONAL) ===
# Necessárias apenas quando o caddy usa o Caddyfile.prod (portas 80/443 + TLS).
# Requer IP público real (sem CGNAT) + port-forward no roteador.
# DOMAIN=share.exemplo.ddns.net
# ACME_EMAIL=admin@exemplo.com

# === NOTAS ===

# O banco SQLite fica no volume nomeado controle-videos-local-backend-data.
# Para resetar o banco: docker compose -f docker-compose.local.yml down -v

# Swagger disponível em http://localhost:8080/api/docs (SWAGGER_ENABLED=true)
# para inspecionar as rotas de auth (R01: Login/Token/Refresh/Verification).

# Para debug do R01 (rotação de refresh token, detecção de reuso SEC-07):
#   docker logs controle-videos-local-backend -f
#   docker compose -f docker-compose.local.yml exec backend sh
