# Local environment for docker-compose.local.yml (gitignored).
# Generate the admin password with: openssl rand -base64 32
ADMIN_PASSWORD=
# Optional overrides for local development:
# ADMIN_EMAIL=admin@empresa.local
# ADMIN_USERNAME=admin

# Database (sqlite file in backend/data)
DATABASE_URL=file:./backend/data/controle-videos.db

# Caddy (local development)
# CADDY_DISABLED=false
# DOMAIN=localhost
# ACME_EMAIL=admin@localhost

# Share directories
DATA_DIRECTORY=./backend/data
SHARE_DIRECTORY=./backend/data/shares

# Config
CONFIG_FILE=./config.yaml

# Swagger
SWAGGER_ENABLED=true

# CORS
CORS_ORIGIN=http://localhost:3333,http://localhost:8080

# JWT signing secret — optional. When set, the backend signs/verifies tokens
# with this value (precedence over the DB secret). In production it usually
# comes from a Docker secret mounted at /run/secrets/jwt_secret.
# JWT_SECRET=
# JWT_SECRET_FILE=/run/secrets/jwt_secret

# Encryption-at-rest for the JWT secrets persisted in the database
# (internal.jwtSecret / internal.jwtSecretHistory), AES-256-GCM.
# Value must be the base64 of 32 bytes; generate with: openssl rand -base64 32
# When unset, DB secrets stay in plaintext (legacy mode, still fully working).
# JWT_SECRET_ENCRYPTION_KEY=
