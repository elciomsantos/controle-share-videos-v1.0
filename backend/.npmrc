# ============================================================
# npm - Segurança
# ============================================================

# Registry oficial
registry=https://registry.npmjs.org/

# Manter package-lock.json
package-lock=true

# Não alterar package.json/package-lock durante instalações
save=false

# Exigir TLS válido
strict-ssl=true

# Manter auditoria habilitada
audit=true

# Scripts de instalação: falha em qualquer script não autorizado via
# allowScripts (package.json). Mais granular que ignore-scripts=true, que
# bloquearia também os binários nativos aprovados (better-sqlite3, argon2,
# @prisma/engines, esbuild, prisma, unrs-resolver).
strict-allow-scripts=true
