{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2021",
    "lib": ["ES2021"],
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": false,
    "sourceMap": false,
    "incremental": false,
    "outDir": "./dist/prisma/seed",
    "rootDir": "./prisma/seed"
  },
  "include": ["prisma/seed/**/*.ts"]
}
