generator client {
  provider     = "prisma-client"
  output       = "./generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  username           String  @unique
  email              String  @unique
  password           String?
  isAdmin            Boolean @default(false)
  role               String  @default("operador")
  shareSizeLimit     BigInt?
  passwordMustChange Boolean @default(false)

  shares        Share[]
  refreshTokens RefreshToken[]
  loginTokens   LoginToken[]

  totpEnabled        Boolean             @default(false)
  totpVerified       Boolean             @default(false)
  totpSecret         String?
  resetPasswordToken ResetPasswordToken?

  isActivated              Boolean   @default(true)
  activationToken          String?   @unique
  activationTokenExpiresAt DateTime?

  // BDB-02: caminho quente do job deleteUnactivatedUsers
  // (isActivated=false AND createdAt<threshold)
  @@index([isActivated, createdAt])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique @default(uuid())
  createdAt DateTime @default(now())

  expiresAt DateTime

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LoginToken {
  token     String   @id @default(uuid())
  createdAt DateTime @default(now())

  expiresAt DateTime

  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  used   Boolean @default(false)
}

model ResetPasswordToken {
  token     String   @id @default(uuid())
  createdAt DateTime @default(now())

  expiresAt DateTime

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Share {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  name          String?
  uploadLocked  Boolean   @default(false)
  isZipReady    Boolean   @default(false)
  views         Int       @default(0)
  downloads     Int       @default(0)
  expiration    DateTime?
  description   String?
  removedReason String?

  creatorId String?
  creator   User?   @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  security ShareSecurity?

  recipients      ShareRecipient[]
  files           File[]
  storageProvider String           @default("LOCAL")

  // BDB-02: orderBy expiration desc (getShares, getSharesByUser) e
  // where expiration { lt / gt } (jobs.deleteExpiredShares).
  @@index([expiration])
  // BDB-02: getSharesByUser filtra por (creatorId, uploadLocked) e
  // ordena por expiration; composite economiza table scan + sort.
  @@index([creatorId, uploadLocked, expiration])
}

model ShareRecipient {
  id    String @id @default(uuid())
  email String

  shareId String
  share   Share  @relation(fields: [shareId], references: [id], onDelete: Cascade)

  // BDB-02: join share→recipients (include em getShares/getSharesByUser)
  // BDB-06: impede duplicidade de destinatário por share (P2/P3 de código)
  @@unique([shareId, email])
  @@index([shareId])
}

model File {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  name        String
  size        BigInt
  description String?

  shareId String
  share   Share  @relation(fields: [shareId], references: [id], onDelete: Cascade)

  // BDB-02: join share→files (include em getShares/getSharesByUser/get)
  @@index([shareId])
}

model ShareSecurity {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  password     String?
  maxViews     Int?
  maxDownloads Int?

  shareId String @unique
  share   Share  @relation(fields: [shareId], references: [id], onDelete: Cascade)
}

model Config {
  updatedAt DateTime @updatedAt

  name         String
  category     String
  type         String
  defaultValue String  @default("")
  value        String?
  obscured     Boolean @default(false)
  secret       Boolean @default(true)
  locked       Boolean @default(false)
  order        Int

  @@id([name, category])
}

model DownloadLog {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  shareId  String
  fileId   String?
  fileName String
  fileSize String?

  userId   String?
  username String?
  ip       String

  userAgent String?

  success Boolean
  reason  String?

  event String @default("download")

  // GAP-02: correlation id propagated from X-Request-Id header so audit rows
  // can be joined back to application logs. Nullable for rows created before
  // the column existed (migration backfills NULL) and for background jobs.
  requestId String?

  @@index([shareId])
  @@index([userId])
  @@index([createdAt])
  @@index([event])
  @@index([requestId])
}
