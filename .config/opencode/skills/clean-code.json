{
  "name": "Clean Code",
  "type": "skill",
  "description": "Princípios de Clean Code para Python/TypeScript",
  "knowledge": [
    "SOLID principles",
    "DRY (Don't Repeat Yourself)",
    "KISS (Keep It Simple, Stupid)",
    "YAGNI (You Ain't Gonna Need It)",
    "Design Patterns (Factory, Strategy, Observer)",
    "Functional programming (map, filter, reduce)",
    "Comprehensions vs loops",
    "Dataclasses e Pydantic"
  ],
  "rules": [
    "Funções com no máximo 20 linhas",
    "Máximo 3 parâmetros por função",
    "Nomes descritivos (evitar x, temp, data)",
    "Uma função = uma responsabilidade",
    "Early returns (evitar nested ifs)",
    "Comentários explicam WHY, não WHAT",
    "Evitar números mágicos (usar constantes)",
    "Preferir composição sobre herança"
  ],
  "patterns": {
    "python": [
      "Usar dataclasses para DTOs",
      "Context managers para recursos",
      "Generators para grandes datasets",
      "f-strings para formatação",
      "walrus operator (:=) quando apropriado"
    ],
    "typescript": [
      "Interfaces sobre types (quando possível)",
      "Optional chaining (?.)",
      "Nullish coalescing (??)",
      "Const assertions",
      "Template literal types"
    ]
  }
}