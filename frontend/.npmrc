# ============================================================
# npm - Segurança
# ============================================================

# Registry oficial
registry=https://registry.npmjs.org/

# Manter package-lock.json
package-lock=true

# Não alterar package.json/package-lock durante instalações
save=false

# Não executar lifecycle scripts automaticamente
ignore-scripts=true

# Exigir TLS válido
strict-ssl=true

# Manter auditoria habilitada
audit=true