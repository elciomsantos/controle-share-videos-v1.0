{
  "$schema": "https://opencode.ai/config.json",

  "lsp": true,

  "experimental": {
    "mcp_timeout": 60000
  },

  "mcp": {
    "filesystem": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/home/suricato/projects"
      ]
    },

    "fetch": {
      "type": "local",
      "enabled": true,
      "command": [
        "uvx",
        "--from",
        "mcp-server-fetch",
        "--with",
        "mcp<2",
        "mcp-server-fetch"
      ]
    },

    "memory": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-memory"
      ]
    },

    "github": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "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"
      }
    },

    "context7": {
      "type": "remote",
      "enabled": true,
      "url": "https://mcp.context7.com/mcp"
    },

    "git": { 
      "type": "local", 
      "command": [
        "uvx",
        "--from",
        "mcp-server-git",
        "--with",
        "mcp<2",
        "mcp-server-git"
      ]
  },

    "sequential-thinking": {
       "type": "local", 
       "enabled": true, 
       "command": [
         "npx", 
         "-y", 
         "@modelcontextprotocol/server-sequential-thinking" 
         ] 
      },

    "playwright": {
       "type": "local",
        "enabled": true,
        "command": [ 
          "npx", 
          "@playwright/mcp@latest" 
          ] 
        },

    "openrouter": { 
      "type": "remote",
      "url": "https://mcp.openrouter.ai/mcp", 
      "headers": { "Authorization": "Bearer {env:OPENROUTER_API_KEY}" },
      "enabled": true }
  }
}