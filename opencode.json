{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,

  "experimental": {
    "mcp_timeout": 60000
  },

  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama Local",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1",
        "apiKey": "{env:OLLAMA_API_KEY}"
      },
      "models": {
        "qwen3:8b": {
          "name": "Qwen 3 8B"
        },
        "llama3.2:3b": {
          "name": "Llama 3.2 3B"
        },
        "qwen3.5:latest": {
          "name": "Qwen 3.5"
        }
      }
    }
  },

  "mcp": {
    "filesystem": {
      "type": "local",
      "enabled": true,
      "timeout": 60000,
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/home/urubu/projects"
      ]
    },

    "fetch": {
      "type": "local",
      "enabled": true,
      "command": [
        "uvx",
        "--from",
        "mcp-server-fetch",
        "--with",
        "mcp<2",
        "mcp-server-fetch"
      ]
    },

    "github": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },

    "context7": {
      "type": "remote",
      "enabled": true,
      "url": "https://mcp.context7.com/mcp"
    },

    "git": {
      "type": "local",
      "enabled": true,
      "command": [
        "uvx",
        "--from",
        "mcp-server-git",
        "--with",
        "mcp<2",
        "mcp-server-git"
      ]
    },

    "sequential-thinking": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },

    "docker": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "mcp-server-docker"
      ]
    },

    "playwright": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "@playwright/mcp@latest",
        "--browser",
        "chromium",
        "--headless"
      ]
    }
  }
}