{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "experimental": {
    "mcp_timeout": 60000
  },
  
  "mcp": {
    "filesystem": {
      "type": "local",
      "enabled": true,
      "command": [
        "/home/suricato/.nvm/versions/node/v24.18.0/bin/npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/home/suricato/projects"
      ]
    },

    "fetch": {
      "type": "local",
      "enabled": true,
      "command": [
        "uvx",
        "--from",
        "mcp-server-fetch",
        "--with", "mcp<2",
        "mcp-server-fetch" 
      ]
    },

    "memory": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-memory"
      ]
    },

    "github": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },

    "context7": {
      "type": "remote",
      "enabled": true,
      "url": "https://mcp.context7.com/mcp"
    },

    "openrouter": {
      "type": "remote",
      "enabled": true,
      "url": "https://mcp.openrouter.ai/mcp",
      "headers": {
        "Authorization": "Bearer {env:OPENROUTER_API_KEY}"
      }
    },

    "git": {
      "type": "local",
      "enabled": true,
      "command": [ 
        "uvx",
        "--from",
        "mcp-server-git",
        "--with",
        "mcp<2",
        "mcp-server-git" 
      ]
    },

    "sequential-thinking": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },

    "docker": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "mcp-docker-server"
      ]
    },

    "desktop": {
      "type": "local",
      "enabled": true,
      "command": [
        "desktop-commander"
      ]
    },

    "ssh": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "mcp-ssh-manager"
      ]
    },
    
    "figma": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "figma-console-mcp"
      ]
    },

    "playwright": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "@playwright/mcp@latest",
        "--browser",
        "chromium",
        "--headless"
      ]
    }
  }
}