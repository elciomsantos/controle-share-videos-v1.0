{
  "$schema": "https://anthropic.ai/config.json",

  "lsp": true,

  "experimental": {
    "mcp_timeout": 60000
  },

  "mcp": {
    "filesystem": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/home/corvo/projects"
      ]
    },

    "fetch": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-fetch"
      ]
    },

    "memory": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-memory"
      ]
    },

    "github": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "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"
      }
    },

    "context7": {
      "type": "remote",
      "enabled": true,
      "url": "https://mcp.context7.com/mcp"
    },

    "openrouter": { 
      "type": "remote",
      "url": "https://mcp.openrouter.ai/mcp", 
      "headers": { "Authorization": "Bearer {env:OPENROUTER_API_KEY}" },
      "enabled": true }
  }
}